  "cards": [
    {
      "dot": "cyan",
      "title": "读路径：注入与召回",
      "items": [
        "policy 段每轮注入；召回关闭时再注入索引视图",
        "召回开启则不注入索引，由会话模型从清单挑 ≤5 个主题",
        "超时、模型报错或坏 JSON 都降级为无召回，本轮照常回答"
      ]
    },
    {
      "dot": "emerald",
      "title": "写路径与不变量",
      "items": [
        "写入先校验类型、路径与字节预算，再取跨进程锁",
        "锁内原子写主题并替换索引行；索引失败如实返回 indexUpdated:false",
        "forget 先落 .recovery 快照；scope 显式，global 禁用时硬失败"
      ]
    }
