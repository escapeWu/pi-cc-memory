{
	"name": "pi-cc-memory",
	"version": "0.2.1",
	"description": "Project- and user-scoped, file-based memory for Pi, modeled on Claude Code auto memory",
	"type": "module",
	"main": "src/extension.ts",
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-package",
		"memory",
		"agent-memory"
	],
	"license": "MIT",
	"files": [
		"src",
		"resources",
		"README.md",
		"CHANGELOG.md",
		"NOTICE",
		"SECURITY.md",
		"LICENSE"
	],
	"scripts": {
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "node --test test/*.test.ts test/integration/*.test.ts",
		"test:integration": "node --test test/integration/*.test.ts",
		"verify:live": "node scripts/verify-live.ts",
		"lint": "biome check src test scripts",
		"verify:m2": "node scripts/verify-m2-live.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@earendil-works/pi-ai": "1.2.0",
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@types/node": "^22.19.0",
		"@types/proper-lockfile": "^4.1.4",
		"typebox": "1.3.27",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.2.0",
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"typebox": ">=1.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/escapeWu/pi-cc-memory.git"
	},
	"bugs": {
		"url": "https://github.com/escapeWu/pi-cc-memory/issues"
	},
	"homepage": "https://github.com/escapeWu/pi-cc-memory#readme",
	"dependencies": {
		"proper-lockfile": "^4.1.2"
	}
}
